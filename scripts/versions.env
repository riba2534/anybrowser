# Upstream assets that scripts/build-app.sh embeds, kept in one place: check-updates.sh compares
# them with upstream, and VersionConsistencyTests holds BundledVersions to the same versions.
# Plain key=value lines only, without quotes, so both the scripts and the test can read them.

# Fingerprint Chromium for macOS ARM64: ungoogled-chromium_<version>-<revision>_macos.dmg
engine_version=148.0.7778.215
engine_revision=1.1
engine_sha256=b72f091e2e1a7583eed389c4b8e3534ed355e568af8c8bbf8fc30a25e23ca679

# Passkey Box for AnyBrowser: passkey-box-extension-anybrowser-v<version>.zip
passkey_version=0.5.0
passkey_sha256=8b7e0d55ef5b9e95107c15e26c930fb69ba3311a4a1f4def3480f777df235516
passkey_id=gfejlnakeokbjdhoionfappnfepjoili
